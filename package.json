{
  "name": "rirote-vision",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "tauri icon src-tauri/app-icon.png",
    "tauri": "tauri",
    "app": "tauri build && codesign --force --deep -s - \"target/release/bundle/macos/RIROTE VISION.app\"",
    "test": "node --test \"src/**/*.test.ts\"",
    "install-app": "npm run app && ditto \"target/release/bundle/macos/RIROTE VISION.app\" \"/Applications/RIROTE VISION.app\""
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@hyperframes/player": "0.8.146",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5.6.0",
    "vite": "^6"
  }
}
